<% layout('layouts/boilerplate') %>


<main class="info-page">

    <div class="info-container">

        <div class="info-header">

            <span class="info-label">PRIVACY</span>

            <h1>Privacy Policy</h1>

            <p>
                Your privacy and security are important to us.
            </p>

        </div>


        <section class="info-card">

            <h2>1. Information We Collect</h2>

            <p>
                CivicTrack may collect information such as your
                name, email address, issue descriptions, images
                and location information when you use the platform.
            </p>


            <h2>2. How We Use Information</h2>

            <p>
                The information collected is used to provide civic
                issue reporting, tracking, communication and
                resolution services.
            </p>


            <h2>3. Account Information</h2>

            <p>
                Users are responsible for keeping their account
                credentials secure. You should not share your
                password with others.
            </p>


            <h2>4. Issue Information</h2>

            <p>
                Information submitted with a civic issue may be
                visible to authorized staff and administrators
                for the purpose of resolving the reported problem.
            </p>


            <h2>5. Data Security</h2>

            <p>
                We take reasonable measures to protect user
                information and maintain the security of the
                platform.
            </p>


            <h2>6. Changes to this Policy</h2>

            <p>
                This privacy policy may be updated when necessary
                to reflect changes to the platform or applicable
                requirements.
            </p>

        </section>

    </div>

</main>

