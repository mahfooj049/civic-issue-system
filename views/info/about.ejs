<% layout('layouts/boilerplate') %>


<main class="info-page">

    <div class="info-container">

        <div class="info-header">
            <span class="info-label">ABOUT US</span>

            <h1>About CivicTrack</h1>

            <p>
                Making communities better through smarter
                civic issue reporting and resolution.
            </p>
        </div>


        <section class="info-card">

            <h2>What is CivicTrack?</h2>

            <p>
                CivicTrack is a crowdsourced civic issue reporting
                and resolution platform designed to connect citizens,
                staff and administrators.
            </p>

            <p>
                Citizens can report problems in their communities,
                track their progress and provide feedback. Staff
                members can manage and resolve assigned issues, while
                administrators can monitor the overall system.
            </p>

        </section>


        <section class="info-grid">

            <div class="info-feature-card">

                <div class="info-icon">📢</div>

                <h3>Report Issues</h3>

                <p>
                    Citizens can easily report civic problems
                    with descriptions, locations and images.
                </p>

            </div>


            <div class="info-feature-card">

                <div class="info-icon">📍</div>

                <h3>Track Progress</h3>

                <p>
                    Users can track the status of reported
                    issues from submission to resolution.
                </p>

            </div>


            <div class="info-feature-card">

                <div class="info-icon">🤝</div>

                <h3>Better Communities</h3>

                <p>
                    CivicTrack encourages collaboration between
                    citizens and authorities.
                </p>

            </div>

        </section>


        <section class="info-card">

            <h2>Our Mission</h2>

            <p>
                Our mission is to make civic issue reporting
                transparent, accessible and efficient while
                helping communities work together to solve
                local problems.
            </p>

        </section>

    </div>

</main>
