<% layout('layouts/boilerplate') %>

<section class="hero">
  <div class="hero-copy">
    <span class="eyebrow">CIVIC INFRASTRUCTURE, CROWDSOURCED</span>
    <h1>Spot it. Report it.<br>Watch it get fixed.</h1>
    <p class="hero-sub">
      Potholes, broken streetlights, overflowing garbage, water leaks &mdash;
      pin the exact spot, snap a photo, and track resolution in real time.
      No more issues lost in phone calls or forgotten complaint registers.
    </p>
    <div class="hero-actions">
      <a href="/issues/new" class="btn btn-primary">Report an Issue</a>
      <a href="/issues" class="btn btn-outline">View Live Map</a>
    </div>
  </div>

  <div class="hero-stamp">
    <div class="stamp-card">
      <div class="stamp-row">
        <span class="stamp-label">STATUS</span>
        <span class="tag tag-progress">IN PROGRESS</span>
      </div>
      <div class="stamp-id">#CIV-2026-0142</div>
      <div class="stamp-divider"></div>
      <div class="stamp-row"><span class="stamp-label">Category</span><span>Pothole</span></div>
      <div class="stamp-row"><span class="stamp-label">Priority</span><span>High</span></div>
      <div class="stamp-row"><span class="stamp-label">Dept</span><span>Roads &amp; Infra</span></div>
      <div class="stamp-row"><span class="stamp-label">SLA</span><span>18h remaining</span></div>
    </div>
  </div>
</section>

<section class="how-it-works">
  <h2>How it works</h2>
  <div class="steps-grid">
    <div class="step-card">
      <span class="step-num">01</span>
      <h3>Report</h3>
      <p>Drop a pin on the map, upload a photo, pick a category. AI suggests the category automatically.</p>
    </div>
    <div class="step-card">
      <span class="step-num">02</span>
      <h3>Verify</h3>
      <p>Nearby duplicate reports are merged automatically &mdash; your upvote adds weight instead of creating noise.</p>
    </div>
    <div class="step-card">
      <span class="step-num">03</span>
      <h3>Assign</h3>
      <p>Issues route to the right municipal department with an SLA deadline attached.</p>
    </div>
    <div class="step-card">
      <span class="step-num">04</span>
      <h3>Resolve</h3>
      <p>Track status changes live: Reported &rarr; Acknowledged &rarr; In Progress &rarr; Resolved.</p>
    </div>
  </div>
</section>
